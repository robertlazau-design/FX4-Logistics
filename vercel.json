{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fx-4-logistics.vercel.app" }],
      "destination": "https://www.fx4logistics.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/portal/:path*", "destination": "/portal" }],
  "headers": [
    {
      "source": "/portal(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
