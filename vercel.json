{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/portal/:path*", "destination": "/portal" }],
  "headers": [
    {
      "source": "/portal(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
